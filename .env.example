API_ID=
API_HASH=
PHONE_NUMBER=

# Local CLI/test storage only
DATABASE_PATH=data/checker.db

# Server-local production Web UI database and encryption
# Keep PostgreSQL bound to 127.0.0.1; replace CHANGE_ME with a strong DB password.
DATABASE_URL=postgresql://checktelegram:CHANGE_ME@127.0.0.1:5432/checktelegram
POSTGRES_CONTAINER=check-telegram-postgres
PERSISTENCE_MASTER_KEY=

DEFAULT_PHONE_REGION=VN

MAX_ATTEMPTS=5

BASE_RETRY_DELAY_SECONDS=30

MAX_RETRY_DELAY_SECONDS=3600

MIN_REQUEST_INTERVAL_SECONDS=

AUTO_RESUME=false

WORKER_LEASE_SECONDS=60

WORKER_STALE_TIMEOUT_SECONDS=30

# Consecutive lease-renew (heartbeat) failures before a worker fails closed.
# Total retry window must not exceed the lease expiry; keep it modest.
LEASE_RENEW_FAILURE_LIMIT=3

# Extra wait after a lease expires before a new worker may take it over.
# Pure concurrency safety (reduces mid-operation takeover), NOT a rate-limit
# workaround. Set to 0 to disable.
LEASE_TAKEOVER_GRACE_SECONDS=0
IN_FLIGHT_RECOVERY_GRACE_SECONDS=60

LOG_LEVEL=INFO

# --- Web UI ---
# Chạy bằng: telegram-phone-number-checker web
# Production sẽ fail-fast nếu không có một credential hợp lệ.
WEB_UI_USERNAME=admin
# WEB_UI_PASSWORD=
# WEB_UI_PASSWORD_SCRYPT=          # khuyến nghị cho production
# WEB_UI_PASSWORD_HASH=            # SHA-256 hex legacy
WEB_UI_COOKIE_SECURE=true
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8000
# WEB_UI_SESSION_MAX_AGE_SECONDS=43200
# WEB_REQUIRE_POSTGRES=true

# Retention chỉ dọn state hết hạn/audit; không xóa Telegram sessions hay jobs.
AUDIT_RETENTION_DAYS=90
SECURITY_MESSAGE_RETENTION_DAYS=30
